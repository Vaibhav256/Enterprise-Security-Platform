POSTGRES_USER=postgres

# -----------------------------------------------------------------------------POSTGRES_PASSWORD=postgres

# Application ConfigurationPOSTGRES_DB=vulnerability_scanner

# -----------------------------------------------------------------------------POSTGRES_PORT=5432

FLASK_APP=run_api.pyDATABASE_URL=postgresql://postgres:postgres@localhost:5432/vulnerability_scanner

FLASK_ENV=development

FLASK_DEBUG=1# Redis Configuration

DEBUG=TrueREDIS_HOST=localhost

REDIS_PORT=6379

# Server ConfigurationREDIS_DB=0

HOST=0.0.0.0REDIS_PASSWORD=

PORT=5000

API_PORT=5000# WSL Configuration

WSL_DISTRIBUTION=kali-linux

# -----------------------------------------------------------------------------GVM_SOCKET_PATH=/var/run/gvmd.sock

# Security - CRITICAL: Change these in production!

# -----------------------------------------------------------------------------# Job Queue Configuration

# Flask secret key for session managementRQ_DASHBOARD_PORT=9181

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"DEFAULT_JOB_TIMEOUT=3600

SECRET_KEY=dev-secret-key-change-in-productionMAX_WORKER_JOBS=10

API_KEY=dev-api-key-change-in-production

# Logging

# JWT secret key for token signingLOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"LOG_FORMAT=json

JWT_SECRET_KEY=dev-jwt-secret-CHANGE-IN-PRODUCTION

# Security (change in production!)

# JWT token expiration (in seconds)SECRET_KEY=your-secret-key-change-this-in-production

JWT_ACCESS_TOKEN_EXPIRES=900          # 15 minutesAPI_KEY=your-api-key-change-this-in-production

JWT_REFRESH_TOKEN_EXPIRES=604800      # 7 days

# CORS Configuration

# JWT Cookie Security (set to True in production with HTTPS)CORS_ORIGINS=http://localhost:3000,http://localhost:8080

JWT_COOKIE_SECURE=False                # Set to True for HTTPS only

JWT_COOKIE_HTTPONLY=True              # Prevent JavaScript access# Scan Configuration

JWT_COOKIE_SAMESITE=Lax               # CSRF protectionMAX_CONCURRENT_SCANS=5

DEFAULT_SCAN_TIMEOUT=3600

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres           # CHANGE IN PRODUCTION!
POSTGRES_DB=vulnerability_scanner
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vulnerability_scanner

# Database pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# Redis Configuration (for Celery task queue)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=                       # Set if Redis requires authentication

# Celery configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# RQ Dashboard (alternative job queue)
RQ_DASHBOARD_PORT=9181
DEFAULT_JOB_TIMEOUT=3600
MAX_WORKER_JOBS=10

# -----------------------------------------------------------------------------
# Security Tool Credentials
# -----------------------------------------------------------------------------
# OpenVAS/GVM credentials
GVM_USERNAME=admin
GVM_PASSWORD=                          # SET YOUR OPENVAS PASSWORD HERE!
GVM_SOCKET=/run/gvmd/gvmd.sock
GVM_SOCKET_PATH=/var/run/gvmd.sock

# Nmap configuration
NMAP_PATH=/usr/bin/nmap
NMAP_SCRIPTS_PATH=/usr/share/nmap/scripts

# Nikto configuration
NIKTO_PATH=/usr/bin/nikto

# Nuclei configuration
NUCLEI_PATH=/usr/bin/nuclei

# -----------------------------------------------------------------------------
# Threat Intelligence Feeds
# -----------------------------------------------------------------------------
# National Vulnerability Database (NVD) API key
# Get your key from: https://nvd.nist.gov/developers/request-an-api-key
# Without key: 5 requests per 30 seconds
# With key: 50 requests per 30 seconds
NVD_API_KEY=                          # Optional but recommended

# ExploitDB configuration
EXPLOITDB_PATH=/usr/share/exploitdb

# -----------------------------------------------------------------------------
# AI/ML Configuration (Intelligence Layer)
# -----------------------------------------------------------------------------
# Ollama configuration for local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M

# ChromaDB configuration for vector database
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=vulnerabilities

# Embedding model (Sentence Transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Email/Notification Configuration
# -----------------------------------------------------------------------------
# SMTP settings for email notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=                        # Your email password or app-specific password
SMTP_USE_TLS=True
SMTP_FROM_ADDRESS=noreply@example.com

# Notification recipients (comma-separated)
ALERT_EMAIL_RECIPIENTS=security-team@example.com,admin@example.com

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                        # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760                # 10MB
LOG_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=True

# -----------------------------------------------------------------------------
# Scan Configuration
# -----------------------------------------------------------------------------
MAX_CONCURRENT_SCANS=5
DEFAULT_SCAN_TIMEOUT=3600             # 1 hour
MAX_SCAN_DURATION=7200                # 2 hours

# -----------------------------------------------------------------------------
# Rate Limiting (when implemented)
# -----------------------------------------------------------------------------
# RATELIMIT_STORAGE_URL=redis://localhost:6379
# RATELIMIT_DEFAULT=100 per hour
# RATELIMIT_LOGIN=5 per minute

# -----------------------------------------------------------------------------
# WSL Configuration (Windows only)
# -----------------------------------------------------------------------------
WSL_DISTRIBUTION=kali-linux
WSL_USERNAME=kali

# -----------------------------------------------------------------------------
# Report Generation
# -----------------------------------------------------------------------------
REPORT_OUTPUT_DIR=./reports
REPORT_TEMPLATE_DIR=./templates
ORGANIZATION_NAME=NTRO
DEFAULT_CLASSIFICATION=CONFIDENTIAL

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_TITLE=NTRO Vulnerability Scanner API
API_VERSION=1.0.0
API_PREFIX=/api
API_DOCS_URL=/api/docs                # Swagger UI endpoint

# -----------------------------------------------------------------------------
# Testing Configuration (use separate test database!)
# -----------------------------------------------------------------------------
# TEST_DATABASE_URL=postgresql://postgres:testpass@localhost:5432/test_vuln_scanner
# PYTEST_TIMEOUT=300
# COVERAGE_MIN=75

# -----------------------------------------------------------------------------
# Production Deployment (Gunicorn)
# -----------------------------------------------------------------------------
# WORKERS=4                           # Number of workers (2 * CPU cores + 1)
# WORKER_CLASS=sync                   # sync, gevent, eventlet
# WORKER_CONNECTIONS=1000
# TIMEOUT=120
# KEEPALIVE=5
# GRACEFUL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Monitoring (Optional)
# -----------------------------------------------------------------------------
# SENTRY_DSN=                         # Sentry error tracking
# DATADOG_API_KEY=                    # Datadog monitoring
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_SWAGGER_UI=True
ENABLE_WEBSOCKET=True
ENABLE_ATTACK_PATHS=True
ENABLE_RAG_CHATBOT=True
ENABLE_THREAT_FEEDS=True

# =============================================================================
# Security Best Practices
# =============================================================================
# 1. Generate strong random secrets:
#    python -c "import secrets; print(secrets.token_hex(32))"
#
# 2. Use environment-specific files:
#    - .env.development (local dev)
#    - .env.staging (staging environment)
#    - .env.production (production - NEVER commit!)
#
# 3. Never commit .env to version control!
#    Add .env to .gitignore
#
# 4. Rotate secrets regularly (every 90 days minimum)
#
# 5. Use strong passwords:
#    - Database: 16+ characters, mixed case, numbers, symbols
#    - GVM: 12+ characters minimum
#    - SMTP: Use app-specific passwords
#
# 6. Enable HTTPS in production:
#    Set JWT_COOKIE_SECURE=True
#
# 7. Restrict CORS_ORIGINS to trusted domains only
#
# 8. Use encrypted database connections (SSL/TLS)
#
# 9. Consider using secrets management:
#    - HashiCorp Vault
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - Google Secret Manager
#
# 10. Regularly audit environment variables
#
# 11. Use least privilege principle for database users
#
# 12. Enable Redis authentication in production
#
# 13. Never use default credentials in production!
#
# =============================================================================
