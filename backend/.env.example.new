# =============================================================================
# ⚠️  SECURITY WARNING - READ BEFORE DEPLOYMENT ⚠️
# =============================================================================
# This is an EXAMPLE configuration file. DO NOT use these values in production!
#
# CRITICAL STEPS:
# 1. Copy this file to .env (already excluded from git)
# 2. Generate secure secrets for production using the commands below
# 3. Never commit .env or secrets to version control
# 4. Rotate secrets regularly (every 90 days minimum)
#
# Generate secure secrets:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Password Requirements:
# - Database: 16+ characters, mixed case, numbers, symbols
# - GVM: 12+ characters minimum
# - SECRET_KEY: 32+ characters (use secrets.token_hex(32))
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
FLASK_APP=run_api.py
FLASK_ENV=development
FLASK_DEBUG=1

# Server Configuration
HOST=0.0.0.0
API_PORT=5000

# -----------------------------------------------------------------------------
# Security - CRITICAL: Change ALL of these in production!
# -----------------------------------------------------------------------------
# Flask secret key for session management (REQUIRED in production)
# MUST be at least 32 characters in production
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️  DO NOT USE THIS DEFAULT IN PRODUCTION ⚠️
SECRET_KEY=dev-secret-key-change-in-production-MINIMUM-32-CHARS

# API key for external API access (OPTIONAL - only if you need API key auth)
API_KEY=

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
# ⚠️  CHANGE THIS PASSWORD IN PRODUCTION (16+ chars recommended) ⚠️
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vulnerability_scanner
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Full database URL (auto-generated from above, or set directly)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vulnerability_scanner

# Database pool settings (optional tuning)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# Redis Configuration (for RQ task queue)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# ⚠️  SET PASSWORD IN PRODUCTION IF REDIS IS EXPOSED ⚠️
REDIS_PASSWORD=

# Redis URL (auto-generated if not set)
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# WSL Configuration (Windows only)
# -----------------------------------------------------------------------------
WSL_DISTRIBUTION=kali-linux
GVM_SOCKET_PATH=/var/run/gvmd.sock

# Security Tool Credentials
# ⚠️  SET THESE BEFORE DEPLOYMENT ⚠️
GVM_USERNAME=admin
GVM_PASSWORD=

# Tool paths (usually auto-detected in WSL)
NMAP_PATH=/usr/bin/nmap
NIKTO_PATH=/usr/bin/nikto
NUCLEI_PATH=/usr/bin/nuclei

# -----------------------------------------------------------------------------
# Job Queue Configuration
# -----------------------------------------------------------------------------
RQ_DASHBOARD_PORT=9181
DEFAULT_JOB_TIMEOUT=3600
MAX_WORKER_JOBS=10

# -----------------------------------------------------------------------------
# Intelligence Layer Configuration (AI/RAG)
# -----------------------------------------------------------------------------
# Timeouts for RAG chatbot operations (in seconds)
INTELLIGENCE_TIMEOUT=120
LLM_INFERENCE_TIMEOUT=60
RETRIEVAL_TIMEOUT=30
REALTIME_ENRICHMENT_TIMEOUT=20

# Ollama configuration for local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M

# ChromaDB configuration for vector database
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=vulnerabilities

# Embedding model (Sentence Transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Threat Intelligence Feeds
# -----------------------------------------------------------------------------
# National Vulnerability Database (NVD) API key (OPTIONAL but recommended)
# Get your key from: https://nvd.nist.gov/developers/request-an-api-key
# Without key: 5 requests per 30 seconds
# With key: 50 requests per 30 seconds
NVD_API_KEY=

# ExploitDB path (if using locally)
EXPLOITDB_PATH=/usr/share/exploitdb

# -----------------------------------------------------------------------------
# Email/Notification Configuration (OPTIONAL)
# -----------------------------------------------------------------------------
# SMTP settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM_ADDRESS=noreply@example.com

# Notification recipients (comma-separated)
ALERT_EMAIL=

# Webhook for alerts (Slack, Discord, etc.)
ALERT_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text

# Log file settings (if using file logging)
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated)
# ⚠️  RESTRICT THIS IN PRODUCTION TO YOUR ACTUAL DOMAINS ⚠️
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# -----------------------------------------------------------------------------
# Scan Configuration
# -----------------------------------------------------------------------------
MAX_CONCURRENT_SCANS=5
DEFAULT_SCAN_TIMEOUT=3600
MAX_SCAN_DURATION=7200
MAX_BULK_DELETE=1000

# -----------------------------------------------------------------------------
# Application URL (for email links, webhooks, etc.)
# -----------------------------------------------------------------------------
APP_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# Production Deployment Settings (Gunicorn)
# -----------------------------------------------------------------------------
# Number of worker processes (recommended: 2 * CPU cores + 1)
# WORKERS=4
# Worker class (gevent for WebSocket support)
# WORKER_CLASS=gevent
# WORKER_CONNECTIONS=1000

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_SWAGGER_UI=True
ENABLE_WEBSOCKET=True
ENABLE_ATTACK_PATHS=True
ENABLE_RAG_CHATBOT=True
ENABLE_THREAT_FEEDS=True

# =============================================================================
# 🔐 PRODUCTION DEPLOYMENT CHECKLIST 🔐
# =============================================================================
#
# Before deploying to production, ensure you have:
#
# ✅ Generated a secure SECRET_KEY (32+ characters)
#    python -c "import secrets; print(secrets.token_hex(32))"
#
# ✅ Changed all default passwords (database, GVM, Redis if exposed)
#
# ✅ Restricted CORS_ORIGINS to your actual domain(s)
#
# ✅ Set up HTTPS/TLS (use Nginx or similar as reverse proxy)
#
# ✅ Configured proper logging and monitoring
#
# ✅ Set up automated database backups
#
# ✅ Reviewed security settings and removed any debug flags
#
# ✅ Never committed .env to version control
#
# =============================================================================
# 📚 ADDITIONAL RESOURCES
# =============================================================================
