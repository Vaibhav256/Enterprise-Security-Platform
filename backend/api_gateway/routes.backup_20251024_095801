@scans_ns.route('/')
class ScanList(Resource):
    """Scan collection endpoint"""
    
    @scans_ns.doc('list_scans')
    @scans_ns.param('status', 'Filter by status', type=str)
    @scans_ns.param('tool_name', 'Filter by tool', type=str)
    @scans_ns.param('page', 'Page number', type=int, default=1)
    @scans_ns.param('per_page', 'Items per page', type=int, default=20)
    @scans_ns.marshal_with(scan_list_model)
    def get(self):
        """List all scans with optional filtering"""
        try:
            # Get query parameters
            status_param = request.args.get('status')
            tool_name = request.args.get('tool_name')
            page = int(request.args.get('page', 1))
            per_page = int(request.args.get('per_page', 20))
            
            # Convert status string to enum
            status = None
            if status_param:
                try:
                    status = ScanStatus[status_param.upper()]
                except KeyError:
                    raise BadRequest(f"Invalid status: {status_param}")
            
            # Get scans
            scans, total = ingestor.list_scans(
                status=status,
                tool=tool_name,
                limit=per_page,
                offset=(page - 1) * per_page
            )
            
            # Convert to response format
            scan_list = []
            for scan in scans:
                scan_list.append({
                    'scan_id': str(scan.scan_id),
                    'target': scan.target,
                    'tool_name': scan.tool_name,
                    'scan_type': scan.scan_type,
                    'status': scan.status.value,
                    'priority': scan.priority,
                    'created_at': scan.created_at.isoformat() if scan.created_at else None,
                    'job_id': scan.job_id
                })
            
            return {
                'scans': scan_list,
                'total': total,
                'page': page,
                'per_page': per_page
            }
            
        except BadRequest:
            raise
        except Exception as e:
            import traceback
            error_details = traceback.format_exc()
            logger.error(f"Error listing scans: {error_details}")
            scans_ns.abort(500, f"Failed to list scans: {type(e).__name__}: {str(e)}")
    
    @scans_ns.doc('create_scan')
    @scans_ns.expect(scan_request_model, validate=True)
    @scans_ns.marshal_with(scan_response_model, code=201)
    def post(self):
        """Create and enqueue a new scan"""
        try:
            import uuid
            data = request.json
            
            # Validate required fields
            required_fields = ['target', 'tool_name', 'scan_type']
            for field in required_fields:
                if field not in data:
                    raise BadRequest(f"Missing required field: {field}")
            
            # Generate scan ID
            scan_id = str(uuid.uuid4())
            
            # Create scan record in database (initial status: PENDING)
            scan = ingestor.create_scan(
                scan_id=scan_id,
                target=data['target'],
                tool_name=data['tool_name'],
                scan_type=data['scan_type'],
                options=data.get('options', {}),
                tags=data.get('tags', []),
                priority=data.get('priority', 'normal'),
                job_id=None  # Will be updated after enqueuing
            )
            
            # Enqueue scan job
            job_id = orchestrator.enqueue_scan(
                scan_id=scan_id,
                target=data['target'],
                tool=data['tool_name'],
                scan_type=data['scan_type'],
                options=data.get('options', {}),
                priority=data.get('priority', 'normal')
            )
            
            # Update the scan with job_id and status
            session = ingestor.get_session()
            try:
                from services.data_ingestor.models import Scan
                scan_obj = session.query(Scan).filter(Scan.scan_id == scan_id).first()
                if scan_obj:
                    scan_obj.status = ScanStatus.PENDING  # Set to PENDING (queued status)
                    scan_obj.job_id = job_id
                    session.commit()
            finally:
                session.close()
            
            # Refresh scan to get updated data
            scan = ingestor.get_scan(scan_id)
            
            return {
                'scan_id': scan_id,
                'target': scan.target,
                'tool_name': scan.tool_name,
                'scan_type': scan.scan_type,
                'status': scan.status.value,
                'priority': scan.priority,
                'created_at': scan.created_at.isoformat(),
                'job_id': job_id
            }, 201
            
        except BadRequest:
            raise
        except Exception as e:
            import traceback
            error_details = traceback.format_exc()
            logger.error(f"Error creating scan: {error_details}")
            scans_ns.abort(500, f"Failed to create scan: {type(e).__name__}: {str(e)}")


@scans_ns.route('/<string:scan_id>')
@scans_ns.param('scan_id', 'The scan identifier')
class Scan(Resource):
    """Single scan endpoint"""
    
    @scans_ns.doc('get_scan')
    @scans_ns.marshal_with(scan_detail_model)
    def get(self, scan_id):
        """Get detailed scan information"""
        try:
            scan = ingestor.get_scan(scan_id)
            
            if not scan:
                raise NotFound(f"Scan {scan_id} not found")
            
            return {
                'scan_id': str(scan.scan_id),
                'target': scan.target,
                'tool_name': scan.tool_name,
                'scan_type': scan.scan_type,
                'status': scan.status.value,
                'progress': scan.progress,
                'priority': scan.priority,
                'created_at': scan.created_at.isoformat() if scan.created_at else None,
                'started_at': scan.started_at.isoformat() if scan.started_at else None,
                'completed_at': scan.completed_at.isoformat() if scan.completed_at else None,
                'execution_time': scan.execution_time,
                'error_message': scan.error_message,
                'options': scan.options,
                'tags': scan.tags,
                'job_id': scan.job_id
            }
            
        except NotFound:
            raise
        except Exception as e:
            scans_ns.abort(500, f"Failed to get scan: {str(e)}")
    
    @scans_ns.doc('delete_scan')
    @scans_ns.response(204, 'Scan deleted/cancelled')
    def delete(self, scan_id):
        """Cancel and delete a scan"""
        try:
            scan = ingestor.get_scan(scan_id)
            
            if not scan:
                raise NotFound(f"Scan {scan_id} not found")
            
            # Cancel job if queued or running
            if scan.job_id and scan.status in [ScanStatus.QUEUED, ScanStatus.RUNNING]:
                orchestrator.cancel_job(scan.job_id)
            
            # Delete scan
            ingestor.delete_scan(scan_id)
            
            return '', 204
            
        except NotFound:
            raise
        except Exception as e:
            scans_ns.abort(500, f"Failed to delete scan: {str(e)}")


