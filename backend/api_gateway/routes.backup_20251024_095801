@scans_ns.route('/bulk/delete')
class BulkDelete(Resource):
    """Bulk delete scans endpoint"""
    
    @scans_ns.doc('bulk_delete_scans')
    @scans_ns.expect(bulk_delete_model)
    @scans_ns.response(200, 'Scans deleted successfully', bulk_delete_response_model)
    @scans_ns.response(400, 'Invalid request')
    @scans_ns.response(500, 'Internal server error')
    def post(self):
        """
        Delete multiple scans
        
        Deletes multiple scans and all associated data (raw results, parsed results, summaries)
        """
        try:
            data = request.get_json()
            scan_ids = data.get('scan_ids', [])
            
            if not scan_ids:
                scans_ns.abort(400, "No scan IDs provided")
            
            if len(scan_ids) > 100:
                scans_ns.abort(400, "Cannot delete more than 100 scans at once")
            
            logger.info(f"🗑️ Bulk delete request for {len(scan_ids)} scans")
            
            deleted = 0
            failed = []
            
            for scan_id in scan_ids:
                try:
                    # Delete from all tables
                    ingestor.delete_scan(scan_id)
                    ingestor.delete_raw_results(scan_id)
                    ingestor.delete_parsed_results(scan_id)
                    ingestor.delete_summary(scan_id)
                    deleted += 1
                    logger.info(f"✅ Deleted scan {scan_id}")
                except Exception as e:
                    logger.error(f"❌ Failed to delete {scan_id}: {str(e)}")
                    failed.append(scan_id)
            
            logger.info(f"🎯 Bulk delete complete: {deleted}/{len(scan_ids)} successful")
            
            return {
                'deleted': deleted,
                'total': len(scan_ids),
                'failed': failed
            }, 200
            
        except BadRequest as e:
            raise e
        except Exception as e:
            logger.error(f"Error in bulk delete: {str(e)}")
            scans_ns.abort(500, f"Bulk delete failed: {str(e)}")


@scans_ns.route('/bulk/export')
class BulkExport(Resource):
    """Bulk export scans endpoint"""
    
    @scans_ns.doc('bulk_export_scans')
    @scans_ns.expect(bulk_export_model)
    @scans_ns.response(200, 'ZIP file with exported scans')
    @scans_ns.response(400, 'Invalid request')
    @scans_ns.response(500, 'Internal server error')
    def post(self):
        """
        Export multiple scans as ZIP
        
        Creates a ZIP archive containing exported scan results in the specified format
        """
        import zipfile
        import io
        from flask import send_file
        from services.export_service.exporters import ExportManager
        
        try:
            data = request.get_json()
            scan_ids = data.get('scan_ids', [])
            format_type = data.get('format', 'pdf')
            
            if not scan_ids:
                scans_ns.abort(400, "No scan IDs provided")
            
            if len(scan_ids) > 50:
                scans_ns.abort(400, "Cannot export more than 50 scans at once")
            
            if format_type not in ['json', 'csv', 'xlsx', 'pdf']:
                scans_ns.abort(400, f"Unsupported format: {format_type}")
            
            logger.info(f"📦 Bulk export request for {len(scan_ids)} scans in {format_type} format")
            
            export_manager = ExportManager(ingestor)
            zip_buffer = io.BytesIO()
            
            with zipfile.ZipFile(zip_buffer, 'w', zipfile.ZIP_DEFLATED) as zip_file:
                exported_count = 0
                
                for scan_id in scan_ids:
                    try:
                        # Get scan data
                        scan = ingestor.get_scan(scan_id)
                        if not scan:
                            logger.warning(f"⚠️ Scan {scan_id} not found, skipping")
                            continue
                        
                        # Export scan
                        result_buffer = export_manager.export_scan(scan_id, format_type)
                        
                        # Add to ZIP with proper filename
                        filename = f"scan-{scan_id[:8]}-{scan.target.replace('/', '_')}.{format_type}"
                        zip_file.writestr(filename, result_buffer.getvalue())
                        
                        exported_count += 1
                        logger.info(f"✅ Exported scan {scan_id} ({exported_count}/{len(scan_ids)})")
                        
                    except Exception as e:
                        logger.error(f"❌ Failed to export {scan_id}: {str(e)}")
                        # Continue with other scans
                        continue
            
            if exported_count == 0:
                scans_ns.abort(404, "No scans could be exported")
            
            logger.info(f"🎯 Bulk export complete: {exported_count}/{len(scan_ids)} scans exported")
            
            # Prepare ZIP for download
            zip_buffer.seek(0)
            timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
            filename = f'bulk-export-{timestamp}.zip'
            
            return send_file(
                zip_buffer,
                mimetype='application/zip',
                as_attachment=True,
                download_name=filename
            )
            
        except BadRequest as e:
            raise e
        except Exception as e:
            logger.error(f"Error in bulk export: {str(e)}")
            scans_ns.abort(500, f"Bulk export failed: {str(e)}")


