# Production Environment Configuration Template
# Copy this to .env.production and customize for your deployment

# ==========================================
# Database Configuration
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123
POSTGRES_DB=vulnerability_scanner
POSTGRES_PORT=5432

# ==========================================
# Redis Configuration
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ==========================================
# Application Configuration
# ==========================================
FLASK_ENV=production
FLASK_DEBUG=0

# CRITICAL: Change this to a random 32+ character string
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING

# ==========================================
# Security
# ==========================================
# JWT (when implemented)
# JWT_SECRET_KEY=CHANGE_THIS_TO_DIFFERENT_RANDOM_STRING

# Rate Limiting (currently disabled per your request)
ENABLE_RATE_LIMITING=false

# ==========================================
# Features
# ==========================================
ENABLE_RAG_CHATBOT=true
ENABLE_THREAT_FEEDS=true

# ==========================================
# External APIs
# ==========================================
# NVD API Key (get from https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=your-nvd-api-key-here

# ==========================================
# Ports
# ==========================================
API_PORT=5000
FRONTEND_PORT=80
RQ_DASHBOARD_PORT=9181

# ==========================================
# ChromaDB
# ==========================================
CHROMA_PERSIST_DIR=/app/chroma_db

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# ==========================================
# Production Deployment Checklist
# ==========================================
# [ ] Changed all passwords above
# [ ] Generated new SECRET_KEY
# [ ] Obtained NVD API key
# [ ] Reviewed security settings
# [ ] Configured backup strategy
# [ ] Set up monitoring/alerting
# [ ] Tested database migrations
# [ ] Configured SSL/TLS certificates
# [ ] Set up reverse proxy (nginx/traefik)
# [ ] Configured firewall rules
